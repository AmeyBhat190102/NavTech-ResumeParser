# ── Server ────────────────────────────────────────────────────────────────────
APP_API_KEY=your-secret-api-key-here

# ── Extraction Strategy ────────────────────────────────────────────────────────
# Options: local | openai | anthropic
EXTRACTION_STRATEGY=openai

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Local HuggingFace Model ────────────────────────────────────────────────────
# NER model for entity extraction
LOCAL_NER_MODEL=dslim/bert-base-NER
# Generative model for structured extraction (needs GPU for large models)
LOCAL_GEN_MODEL=mistralai/Mistral-7B-Instruct-v0.2
# Set to 'cpu' if no GPU available (slow but functional)
LOCAL_DEVICE=cpu
